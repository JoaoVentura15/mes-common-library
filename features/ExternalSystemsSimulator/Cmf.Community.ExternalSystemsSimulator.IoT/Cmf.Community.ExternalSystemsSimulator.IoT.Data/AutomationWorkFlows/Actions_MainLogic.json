        "contextExpirationInMilliseconds": 10000,
        "executionExpirationInMilliseconds": 0,
        "tsCode": [
          "import { Framework } from 'framework';",
          "",
          "export default class {",
          "",
          "    /** Allows accessing external functions */",
          "    private framework: Framework;",
          "",
          "    constructor(framework: Framework) {",
          "        this.framework = framework;",
          "    }",
          "",
          "    /*",
          "     * Entry point of the class (IMPORTANT: don't change the signature of this method)",
          "     * Should return an object containing the values for each output to emit",
          "     * If necessary, use the parameter \"outputs\" to emit data while running the code.",
          "     */",
          "    public async main(inputs: any, outputs: any): Promise<any> {",
          "        // Add code here    ",
          "        debugger;",
          "        let currentEndpointConfig: EndpointConfig = inputs.CurrentEndpointConfig;",
          "        let actions: Action[] = currentEndpointConfig.ActionsToExecute;",
          "",
          "        let actionsToExecute = actions.length;",
          "",
          "        for (var index in actions) {",
          "",
          "            var action = actions[index];",
          "            var updatedAction = false;",
          "            if (!action.Id) {",
          "                action.Id = \"Action_\" + inputs.RequestId + \"_\" + index;",
          "                updatedAction = true;",
          "            }",
          "",
          "            action = await this.framework.dataStore.retrieve(action.Id, action);",
          "            actions[index] = action;",
          "",
          "            //Default action state",
          "            if (!action.ActionState) {",
          "                action.ActionState = ActionStates.Created;",
          "                updatedAction = true;",
          "            }",
          "",
          "            if (updatedAction) {",
          "                actions[index] = action;",
          "                await this.framework.dataStore.store(action.Id, action, \"Persistent\");",
          "            }",
          "",
          "            if (action.ActionState === ActionStates.Processed || action.ActionState === ActionStates.Failed) {",
          "                actionsToExecute--;",
          "            }",
          "",
          "            if (action.ActionState !== ActionStates.Created) {",
          "                continue;",
          "            }",
          "",
          "            if (action.DependsOn && action.DependsOn.length > 0) {",
          "                // Check if there are any dependencies that are NOT 'Processed' yet",
          "                const dependenciesMet = action.DependsOn.every((depId: any) => {",
          "                    const depAction = actions.find(a => a.Id === depId);",
          "                    return depAction && depAction.ActionState === ActionStates.Processed;",
          "                });",
          "                if (!dependenciesMet) {",
          "                    // If not all dependencies are Processed, skip this action for now",
          "                    continue;",
          "                }",
          "            }",
          "",
          "            //Update action",
          "            //Needs to be this order to prevent concurrency issues",
          "            action.ActionState = ActionStates.Requested;",
          "            actions[index] = action;",
          "            await this.framework.dataStore.store(action.Id, action, \"Persistent\");",
          "",
          "            this.framework.logger.info(\"Triggering \" + JSON.stringify(action));",
          "",
          "            currentEndpointConfig.ActionsToExecute = actions;",
          "",
          "            return { RequestId: inputs.RequestId, CurrentEndpointConfig: currentEndpointConfig, ActionToExecute: action }",
          "        }",
          "",
          "        if (actionsToExecute == 0) {",
          "            this.framework.logger.info(\"Finished executing all actions!\");",
          "",
          "            //Clean persistency",
          "            for (var index in actions) {",
          "                await this.framework.dataStore.store(actions[index].Id, undefined, \"Persistent\");",
          "            }",
          "",
          "            return { RequestId: inputs.RequestId, CurrentEndpointConfig: inputs.CurrentEndpointConfig, success: true };",
          "        }",
          "",
          "        currentEndpointConfig.ActionsToExecute = actions;",
          "",
          "        //Wating for actions to finish",
          "        return {",
          "            RequestId: inputs.RequestId,",
          "            CurrentEndpointConfig: currentEndpointConfig",
          "        }",
          "",
          "        // emit output during execution: outputs.output1.emit(\"something\");",
          "        // return example: return { output1: inputs.input1, output2: \"Hello World\" };",
          "    }",
          "}",
          "//Model for AutomationEvent ExtendedData",
          "class CustomExtendedData {",
          "    DefaultActions: Action[];",
          "    DefaultBody: string;",
          "    DefaultStatusCode: number",
          "}",
          "",
          "//Model for ActionParameter for action of type LogEvent",
          "class LogEventParameter {",
          "    EntityType: string;",
          "    EntityId: string | undefined;",
          "    EntityName: string | undefined;",
          "    ToState: string;",
          "    IgnoreLastServiceId = false;",
          "}",
          "",
          "//Model for CustomCode ",
          "class CustomCodeParameters {",
          "    ParameterNames: string[];",
          "    Parameters: any[];",
          "    Function: string;",
          "}",
          "",
          "//Generic data model",
          "class EndpointConfig {",
          "    Id: string | undefined;",
          "    StatusCode: number | undefined;",
          "    BodyToSend: any;",
          "    ActionsToExecute: Action[] | undefined;",
          "",
          "    constructor(init?: Partial<EndpointConfig>) {",
          "        Object.assign(this, init);",
          "        if (!this.Id) {",
          "            this.Id = crypto.randomUUID();",
          "        }",
          "    }",
          "",
          "    static GetNew(statusCodeToSet: number, bodyToSet: any): EndpointConfig {",
          "        return new EndpointConfig({",
          "            Id: crypto.randomUUID(),",
          "            StatusCode: statusCodeToSet,",
          "            BodyToSend: bodyToSet,",
          "        });",
          "    }",
          "}",
          "",
          "class Action {",
          "    Id: string | undefined;",
          "    ActionType: string;",
          "    ActionState: ActionStates;",
          "    ActionParameter: any;",
          "    DependsOn: string[] | undefined;",
          "",
          "    constructor(init?: Partial<Action>) {",
          "        if (!init || !init.ActionType || !init.ActionParameter) {",
          "            throw new Error(\"Invalid input. Received: \" + JSON.stringify(init));",
          "        }",
          "        this.Id = init.Id ?? crypto.randomUUID();",
          "        this.ActionType = init.ActionType;",
          "        this.ActionState = init.ActionState ?? ActionStates.Created;",
          "        this.ActionParameter = init.ActionParameter;",
          "    }",
          "}",
          "",
          "class EndpointStatistic {",
          "    RequestId: string | undefined;",
          "    EndpointConfig: EndpointConfig | undefined;",
          "    ReceivedBody: any;",
          "    ReplySent: any;",
          "    StatusCodeSent: number | undefined;",
          "    Error: any",
          "}",
          "",
          "enum ActionStates {",
          "    \"Created\",",
          "    \"Requested\",",
          "    \"Processed\",",
          "    \"Failed\"",
          "}",
          ""
        ],
        "jsCodeBase64": "",
        "___cmf___name": "Code"
      }
    }
