        "tsCode": [
          "import { Framework } from 'framework';",
          "",
          "export default class {",
          "",
          "    /** Allows accessing external functions */",
          "    private framework: Framework;",
          "",
          "    constructor(framework: Framework) {",
          "        this.framework = framework;",
          "    }",
          "",
          "    /*",
          "     * Entry point of the class (IMPORTANT: don't change the signature of this method)",
          "     * Should return an object containing the values for each output to emit",
          "     * If necessary, use the parameter \"outputs\" to emit data while running the code.",
          "     */",
          "    public async main(inputs: any, outputs: any): Promise<any> {",
          "        // Add code here",
          "        var action = inputs.Action as Action;",
          "",
          "        if(action.ActionType !== \"LogEvent\"){",
          "            throw new Error (\"Invalid action ->\" + JSON.stringify(action));",
          "        }",
          "",
          "        let parameters = action.ActionParameter as LogEventParameter;",
          "",
          "        if(!parameters){",
          "            throw new Error(\"Missing or invalid parameters. Got -> \" + JSON.stringify(parameters));",
          "        }",
          "",
          "        var entity = await this.LoadObject(parameters.EntityType, parameters.EntityId, parameters.EntityName);",
          "        var stateTransition = await this.GetStateTransition(entity, parameters.ToState, entity.CurrentMainState.CurrentState)",
          "",
          "        return { ",
          "            Object: entity,",
          "            LogObjectEventParameters: { \"TransitionName\": stateTransition, \"StateModel\": entity.CurrentMainState.StateModel },",
          "            IgnoreLastServiceId : parameters.IgnoreLastServiceId",
          "        };",
          "",
          "        // emit output during execution: outputs.output1.emit(\"something\");",
          "        // return example: return { output1: inputs.input1, output2: \"Hello World\" };",
          "    }",
          "",
          "    ",
          "    private async GetStateTransition(entity: any, toState: string, currentState: string): Promise<string> {",
          "",
          "        var sm = new this.framework.LBOS.Cmf.Foundation.BusinessOrchestration.StateModelsManagement.InputObjects.GetPossibleTransitionsForStateInput();",
          "",
          "        sm.StateModel = entity.CurrentMainState.StateModel;",
          "        sm.StateModelState = entity.CurrentMainState.CurrentState;",
          "",
          "        var possibleTransitions = new this.framework.LBOS.Cmf.Foundation.BusinessObjects.StateModelTransitionCollection;",
          "        possibleTransitions = (await this.framework.system.call(sm)).StateModelTransitions;",
          "",
          "        for (let transition of possibleTransitions) {",
          "           if(transition?.ToState?.Name === toState){",
          "                return transition?.Name;",
          "           }",
          "        }",
          "",
          "        if (toState == undefined && currentState === entity.CurrentMainState.CurrentState.Name){",
          "            return possibleTransitions[0]?.Name;",
          "        }",
          "",
          "        if(toState){",
          "            throw new Error(`No transition found to ${toState} for the batch ${entity.Name} current state ${entity.CurrentMainState.CurrentState.Name}`);        ",
          "        }",
          "        throw new Error(`Event does not match current batch state expected: ${currentState} got ${entity.CurrentMainState.CurrentState.Name}`);",
          "    }",
          "",
          "    private async LoadObject(entityType: string, EntityId? : string, EntityName? : string): Promise<any>{",
          "               ",
          "        if(EntityId && entityType){",
          "            let getObjectByIdInput = new this.framework.LBOS.Cmf.Foundation.BusinessOrchestration.GenericServiceManagement.InputObjects.GetObjectByIdInput;",
          "            getObjectByIdInput.Id = EntityId;",
          "            getObjectByIdInput.LevelsToLoad = 1;",
          "            getObjectByIdInput.Type = entityType;",
          "            const getObjectByIdResult = await this.framework.system.call(getObjectByIdInput);",
          "            ",
          "            if(getObjectByIdResult.Instance){",
          "                return getObjectByIdResult.Instance;",
          "            }",
          "        }",
          "",
          "        if(EntityName && entityType){",
          "            let getObjectByNameInput = new this.framework.LBOS.Cmf.Foundation.BusinessOrchestration.GenericServiceManagement.InputObjects.GetObjectByNameInput;",
          "            getObjectByNameInput.Name = EntityName;",
          "            getObjectByNameInput.LevelsToLoad = 1;",
          "            getObjectByNameInput.Type = entityType;",
          "            const getObjectByNameResult = await this.framework.system.call(getObjectByNameInput);",
          "",
          "            if(getObjectByNameResult.Instance){",
          "                return getObjectByNameResult.Instance;",
          "            }",
          "        }",
          "",
          "        throw new Error(\"Unable to get entity -> EntityType: \"+ entityType +\" | EntityId: \" + EntityId + \" | EntityName: \"+ EntityName);",
          "    }",
          "}",
          "//Model for AutomationEvent ExtendedData",
          "class CustomExtendedData {",
          "    DefaultActions: Action[];",
          "    DefaultBody: string;",
          "    DefaultStatusCode : number",
          "}",
          "",
          "//Model for ActionParameter for action of type LogEvent",
          "class LogEventParameter {",
          "    EntityType : string;",
          "    EntityId: string | undefined;",
          "    EntityName: string | undefined;",
          "    ToState : string;",
          "    IgnoreLastServiceId = false;",
          "}",
          "",
          "//Model for CustomCode ",
          "class CustomCodeParameters {",
          "    ParameterNames: string[];",
          "    Parameters: any[];",
          "    Function: string;",
          "}",
          "",
          "//Generic data model",
          "class EndpointConfig{",
          "    Id: string|undefined;",
          "    StatusCode : number|undefined;",
          "    BodyToSend: any;",
          "    ActionsToExecute: Action[] | undefined;",
          "",
          "    constructor(init?: Partial<EndpointConfig>) {",
          "        Object.assign(this, init);",
          "        if(!this.Id){",
          "            this.Id = crypto.randomUUID();",
          "        }",
          "    }",
          "",
          "    static GetNew(statusCodeToSet: number, bodyToSet: any): EndpointConfig {",
          "        return new EndpointConfig({",
          "            Id: crypto.randomUUID(),",
          "            StatusCode: statusCodeToSet,",
          "            BodyToSend: bodyToSet,",
          "        });",
          "    }",
          "}",
          "",
          "class Action {",
          "    Id: string|undefined;",
          "    ActionType: string;",
          "    ActionState: ActionStates;",
          "    ActionParameter: any;",
          "    DependsOn: string[] | undefined;",
          "",
          "     constructor(init?: Partial<Action>) {",
          "        if(!init || !init.ActionType ||!init.ActionParameter){",
          "            throw new Error(\"Invalid input. Received: \" + JSON.stringify(init));",
          "        }",
          "        this.Id = init.Id ?? crypto.randomUUID();",
          "        this.ActionType = init.ActionType;",
          "        this.ActionState = init.ActionState ?? ActionStates.Created;",
          "        this.ActionParameter = init.ActionParameter;",
          "    }",
          "}",
          "",
          "class EndpointStatistic {",
          "    RequestId : string | undefined;",
          "    EndpointConfig: EndpointConfig|undefined;",
          "    ReceivedBody: any;",
          "    ReplySent: any;",
          "    StatusCodeSent: number|undefined;",
          "    Error: any",
          "}",
          "",
          "enum ActionStates {",
          "    \"Created\",",
          "    \"Requested\",",
          "    \"Processed\",",
          "    \"Failed\"",
          "}",
          ""
        ],
