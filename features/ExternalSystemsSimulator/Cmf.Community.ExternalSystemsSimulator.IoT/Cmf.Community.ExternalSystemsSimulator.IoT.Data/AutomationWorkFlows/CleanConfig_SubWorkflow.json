        "tsCode": [
          "import { Framework } from 'framework';",
          "",
          "export default class {",
          "",
          "    /** Allows accessing external functions */",
          "    private framework: Framework;",
          "",
          "    constructor(framework: Framework) {",
          "        this.framework = framework;",
          "    }",
          "",
          "    /*",
          "     * Entry point of the class (IMPORTANT: don't change the signature of this method)",
          "     * Should return an object containing the values for each output to emit",
          "     * If necessary, use the parameter \"outputs\" to emit data while running the code.",
          "     */",
          "    public async main(inputs: any, outputs: any): Promise<any> {",
          "        // Add code here",
          "        var data = inputs.data;",
          "",
          "        if(Array.isArray(data)){ //To clean just selected ones",
          "            for(var subjectIndex in data){",
          "                this.framework.dataStore.store(data[subjectIndex], undefined, \"Persistent\");    ",
          "            }",
          "        } else {",
          "            var parsedTopic = this.parseTopic(inputs.subject);",
          "            ",
          "            if (parsedTopic){",
          "                var sub = parsedTopic.subsection;",
          "                var subject = parsedTopic.topic;",
          "                var statSubject = subject + \"Stat\";",
          "",
          "                if(sub){",
          "                    switch(sub){",
          "                        case \"Configuration\":",
          "                            await this.framework.dataStore.store(subject, this.GetFilteredList<any>(subject, inputs.data), \"Persistent\");",
          "                            break;",
          "                        case \"Statistics\":",
          "                            await this.framework.dataStore.store(statSubject, this.GetFilteredList<any>(statSubject, inputs.data), \"Persistent\");",
          "                            break;",
          "                    }                    ",
          "                } else {",
          "                    await this.framework.dataStore.store(subject, this.GetFilteredList<any>(subject, inputs.data), \"Persistent\");",
          "                    await this.framework.dataStore.store(statSubject, this.GetFilteredList<any>(statSubject, inputs.data), \"Persistent\");",
          "                }                ",
          "            } else {",
          "                var keys = await this.framework.dataStore.listKeys(\"Persistent\");",
          "                keys = keys.filter((key) => !key.startsWith('_'));",
          "                this.framework.logger.warning(`Clearing all non system keys from Persistent store -> ${keys}`);",
          "",
          "                for(var key in keys){",
          "                   await this.framework.dataStore.store(keys[key], undefined, \"Persistent\"); ",
          "                }",
          "            }",
          "        }",
          "        ",
          "        this.framework.logger.info(`Current keys ${JSON.stringify(await this.framework.dataStore.listKeys(\"Persistent\"))}`);",
          "",
          "        if(inputs.IsRequest){",
          "            return { reply: data,  IsRequestOut : true };",
          "        } else {",
          "            return { reply: data };",
          "        }",
          "",
          "        // emit output during execution: outputs.output1.emit(\"something\");",
          "        // return example: return { output1: inputs.input1, output2: \"Hello World\" };",
          "    }",
          "",
          "    public parseTopic(input: string): { subsection?: string; topic?: string } {",
          "        let prefix = \"ExternalSystemsSimulator.Clear\"",
          "",
          "        if (!input.startsWith(prefix)) {",
          "            throw new Error(\"Invalid format\");",
          "        }",
          "",
          "        const rest = input === prefix ? \"\" : input.slice(prefix.length + 1);",
          "",
          "        if (!rest) {",
          "            return undefined;",
          "        }",
          "",
          "        const parts = rest.split(\".\");",
          "",
          "        if (parts.length === 1) {",
          "            return { topic: parts[0] };",
          "        }",
          "",
          "        if (parts.length === 2) {",
          "            const [subsection, topic] = parts;",
          "            return { subsection, topic };",
          "        }",
          "",
          "        throw new Error(\"Unexpected format\");",
          "    }",
          "",
          "    public async GetFilteredList<T extends object>(store: string, template: Partial<T>) : Promise<T[]> {",
          "        var tempList = await this.framework.dataStore.retrieve(store, undefined) as T[];",
          "        ",
          "        if(tempList){",
          "            tempList = this.removeMatches<T>(tempList, template)",
          "        }",
          "        ",
          "        if(tempList?.length > 0){",
          "            return tempList;",
          "        }",
          "",
          "        return undefined;",
          "    }",
          "",
          "    public matchesTemplate(item: unknown, template: unknown): boolean {",
          "        if (template === item) return true;",
          "",
          "        if (",
          "            typeof template !== \"object\" || template === null ||",
          "            typeof item !== \"object\" || item === null",
          "        ) {",
          "            return false;",
          "        }",
          "",
          "        if (Array.isArray(template)) {",
          "            if (!Array.isArray(item) || template.length !== item.length) return false;",
          "            return template.every((v, i) => this.matchesTemplate(item[i], v));",
          "        }",
          "",
          "        for (const [key, value] of Object.entries(template as Record<string, unknown>)) {",
          "            if (!this.matchesTemplate((item as Record<string, unknown>)[key], value)) {",
          "            return false;",
          "            }",
          "        }",
          "",
          "        return true;",
          "    }",
          "    ",
          "    public removeMatches<T extends object>(items: T[], template: Partial<T>): T[] {",
          "        return items.filter(item => !this.matchesTemplate(item, template));",
          "    }",
          "}",
          ""
        ],
        "jsCodeBase64": "",
        "___cmf___name": "Clean Config"
      }
    },
