        "contextExpirationInMilliseconds": 10000,
        "executionExpirationInMilliseconds": 0,
        "tsCode": [
          "import { Framework } from 'framework';",
          "",
          "export default class {",
          "",
          "    /** Allows accessing external functions */",
          "    private framework: Framework;",
          "",
          "    constructor(framework: Framework) {",
          "        this.framework = framework;",
          "    }",
          "",
          "    /*",
          "     * Entry point of the class (IMPORTANT: don't change the signature of this method)",
          "     * Should return an object containing the values for each output to emit",
          "     * If necessary, use the parameter \"outputs\" to emit data while running the code.",
          "     */",
          "    public async main(inputs: any, outputs: any): Promise<any> {",
          "        // Add code here",
          "        debugger;",
          "        var eventData = inputs.EventRawData;                ",
          "        var subjectName = eventData.event.Name;",
          "        var messageBody = eventData.values.find((y: { property: { Name: string; }; }) => y.property.Name === \"MessageBody\").value;",
          "        var extendedData : CustomExtendedData = JSON.parse(eventData?.event?.ExtendedData) as CustomExtendedData;",
          "        var actions : Action[];",
          "        var endpointConfigList = await this.framework.dataStore.retrieve(subjectName, undefined) as EndpointConfig[]",
          "        var endpointConfig : EndpointConfig = undefined;",
          "        var requestId = inputs.RequestId;",
          "",
          "        if (!requestId){",
          "            requestId  = eventData.values.find((y: { property: { Name: string; }; }) => y.property.Name === \"RequestId\").value;",
          "        }",
          "        ",
          "        if(endpointConfigList){",
          "            endpointConfig = endpointConfigList.pop();",
          "            await this.framework.dataStore.store(subjectName, endpointConfigList.length > 0 ? endpointConfigList : undefined, \"Persistent\");",
          "        }",
          "",
          "        if(!endpointConfig && extendedData){",
          "            if(extendedData.DocumentName){",
          "                //Get Document Id",
          "",
          "                var getInput = new this.framework.LBOS.Cmf.Foundation.BusinessOrchestration.GenericServiceManagement.InputObjects.GetObjectByNameInput();",
          "                getInput.Name = extendedData.DocumentName;",
          "                getInput.Type = \"Cmf.Foundation.BusinessObjects.Document\";",
          "",
          "                var document = (await this.framework.system.call(getInput)).Instance;",
          "",
          "                //Get Document data",
          "                var DownloadDocumentStreamingInput = this.framework.LBOS.Cmf.Services.GenericServiceManagement.DownloadDocumentStreamingInput;",
          "                ",
          "                var serviceInput : any = {};",
          "                serviceInput[\"constructor\"] = {",
          "                    \"_CMFInternal_HTTPMethod\": DownloadDocumentStreamingInput._CMFInternal_HTTPMethod,",
          "                    \"_CMFInternal_URLSuffix\": DownloadDocumentStreamingInput._CMFInternal_URLSuffix + \"/\" + document.Id ",
          "                }    ",
          "",
          "                extendedData = await this.framework.system.call(serviceInput);",
          "            } ",
          "            ",
          "            if(extendedData?.DefaultBody || extendedData?.DefaultStatusCode || extendedData.DefaultActions ){",
          "                endpointConfig = {",
          "                    Id: requestId,",
          "                    BodyToSend: extendedData.DefaultBody,",
          "                    StatusCode: extendedData.DefaultStatusCode,  ",
          "                    ActionsToExecute: extendedData.DefaultActions          ",
          "                } as EndpointConfig;",
          "            }",
          "        }",
          "",
          "        endpointConfig = this.interpolateObject(endpointConfig, messageBody);",
          "        ",
          "        if(endpointConfig?.ActionsToExecute){",
          "            actions = endpointConfig.ActionsToExecute;",
          "        }        ",
          "",
          "        // emit output during execution: outputs.output1.emit(\"something\");",
          "        if(actions && actions.length > 0){",
          "            return {",
          "                RequestId: requestId,",
          "                Subject: subjectName,",
          "                Body: messageBody,",
          "                RunningEndpointConfig : endpointConfig,",
          "                Actions: actions",
          "            };",
          "        } else {",
          "            return {",
          "                RequestId: requestId,",
          "                Subject: subjectName,",
          "                Body: messageBody,",
          "                RunningEndpointConfig: endpointConfig,",
          "                NoActionToExecute: true,",
          "                Actions: undefined",
          "            };",
          "        }",
          "    }",
          "",
          "    public getByPath(obj: any, path: string): any {",
          "        // Normalize bracket notation: \"Materials[0].Name\" -> \"Materials.0.Name\"",
          "        const normalizedPath = path.replace(/\\[(\\d+)\\]/g, \".$1\");",
          "        return normalizedPath.split(\".\").reduce((acc, key) => (acc == null ? undefined : acc[key]), obj);",
          "    }",
          "",
          "    public interpolateString(",
          "        template: string,",
          "        params: Record<string, any>,",
          "        start = \"{{\",",
          "        end = \"}}\"",
          "    ): string {",
          "        const esc = (s: string) => s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");",
          "        const pattern = new RegExp(`${esc(start)}([^${esc(end[0])}]+)${esc(end)}`, \"g\");",
          "",
          "        return template.replace(pattern, (_, rawKey: string) => {",
          "            const key = rawKey.trim();               // e.g. \"material.Id\"",
          "            const value = this.getByPath(params, key);    // look up in request body",
          "            return value != null ? String(value) : \"\";",
          "        });",
          "    }",
          "",
          "    public interpolateObject<T>(template: T, params: Record<string, any>): T {",
          "        if (typeof template === \"string\") {",
          "            return  this.interpolateString(template, params) as unknown as T;",
          "        }",
          "",
          "        if (Array.isArray(template)) {",
          "            return template.map(item =>  this.interpolateObject(item, params)) as unknown as T;",
          "        }",
          "",
          "        if (template && typeof template === \"object\") {",
          "            const result: any = {};",
          "            for (const [k, v] of Object.entries(template)) {",
          "            result[k] =  this.interpolateObject(v as any, params);",
          "            }",
          "            return result;",
          "        }",
          "",
          "        return template;",
          "    }",
          "",
          "}",
          "",
          "//Model for AutomationEvent ExtendedData",
          "class CustomExtendedData {",
          "    DefaultActions: Action[];",
          "    DefaultBody: string;",
          "    DefaultStatusCode : number;",
          "    DocumentName: string;",
          "}",
          "",
          "//Model for ActionParameter for action of type LogEvent",
          "class LogEventParameter {",
          "    EntityType : string;",
          "    EntityId: string | undefined;",
          "    EntityName: string | undefined;",
          "    ToState : string;",
          "    IgnoreLastServiceId = false;",
          "}",
          "",
          "//Model for CustomCode ",
          "class CustomCodeParameters {",
          "    ParameterNames: string[];",
          "    Parameters: any[];",
          "    Function: string;",
          "}",
          "",
          "//Generic data model",
          "class EndpointConfig{",
          "    Id: string|undefined;",
          "    StatusCode : number|undefined;",
          "    BodyToSend: any;",
          "    ActionsToExecute: Action[] | undefined;",
          "",
          "    constructor(init?: Partial<EndpointConfig>) {",
          "        Object.assign(this, init);",
          "        if(!this.Id){",
          "            this.Id = crypto.randomUUID();",
          "        }",
          "    }",
          "",
          "    static GetNew(statusCodeToSet: number, bodyToSet: any): EndpointConfig {",
          "        return new EndpointConfig({",
          "            Id: crypto.randomUUID(),",
          "            StatusCode: statusCodeToSet,",
          "            BodyToSend: bodyToSet,",
          "        });",
          "    }",
          "}",
          "",
          "class Action {",
          "    Id: string|undefined;",
          "    ActionType: string;",
          "    ActionState: ActionStates;",
          "    ActionParameter: any;",
          "    DependsOn: string[] | undefined;",
          "",
          "     constructor(init?: Partial<Action>) {",
          "        if(!init || !init.ActionType ||!init.ActionParameter){",
          "            throw new Error(\"Invalid input. Recieved: \" + JSON.stringify(init));",
          "        }",
          "        this.Id = init.Id ?? crypto.randomUUID();",
          "        this.ActionType = init.ActionType;",
          "        this.ActionState = init.ActionState ?? ActionStates.Created;",
          "        this.ActionParameter = init.ActionParameter;",
          "    }",
          "}",
          "",
          "class EndpointStatistic {",
          "    RequestId : string | undefined;",
          "    EndpointConfig: EndpointConfig|undefined;",
          "    RecievedBody: any;",
          "    ReplySent: any;",
          "    StatusCodeSent: number|undefined;",
          "    Error: any",
          "}",
          "",
          "enum ActionStates {",
          "    \"Created\",",
          "    \"Requested\",",
          "    \"Processed\",",
          "    \"Failed\"",
          "}",
          ""
        ],
        "jsCodeBase64": "",
        "___cmf___name": "Code",
        "___cmf___description": "GetEventData"
      }
