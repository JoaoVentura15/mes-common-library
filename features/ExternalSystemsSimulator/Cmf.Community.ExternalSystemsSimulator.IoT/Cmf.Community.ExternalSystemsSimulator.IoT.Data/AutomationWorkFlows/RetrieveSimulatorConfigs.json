        "tsCode": [
          "import { Framework } from 'framework';\r",
          "\r",
          "export default class {\r",
          "\r",
          "    /** Allows accessing external functions */\r",
          "    private framework: Framework;\r",
          "\r",
          "    constructor(framework: Framework) {\r",
          "        this.framework = framework;\r",
          "    }\r",
          "\r",
          "    /*\r",
          "     * Entry point of the class (IMPORTANT: don't change the signature of this method)\r",
          "     * Should return an object containing the values for each output to emit\r",
          "     * If necessary, use the parameter \"outputs\" to emit data while running the code.\r",
          "     */\r",
          "    public async main(inputs: any, outputs: any): Promise<any> {\r",
          "        // Add code here\r",
          "        var parsedData = this.parseTopic(inputs.subject);\r",
          "        var sub = parsedData?.subsection;\r",
          "        var replyToSend = {};\r",
          "        var toMatch = inputs.data;\r",
          "        \r",
          "        this.framework.logger.info(\"Subject -> \" + inputs.subject);\r",
          "        this.framework.logger.info(\"ParsedData -> \" + JSON.stringify(parsedData)); \r",
          "        \r",
          "        var currentRunningConfig : RunningConfig = await this.framework.dataStore.retrieve(\"RunningConfig\", undefined) ?? new RunningConfig();\r",
          "    \r",
          "        if(!sub){\r",
          "            return { reply: currentRunningConfig, IsRequestOut: inputs.isRequest};\r",
          "        }       \r",
          "\r",
          "        this.framework.logger.info(\"Retrieving config for -> \" + sub + \":\" + JSON.stringify(parsedData));\r",
          "\r",
          "        if(parsedData  && currentRunningConfig.RunningMode == RunningMode.NoStatistics){\r",
          "            throw new Error(\"Currently configured with no statistics\");\r",
          "        }      \r",
          "\r",
          "        var subject = parsedData.topic;\r",
          "        var statSubject = subject+\"Stat\";\r",
          "        \r",
          "        if(sub){\r",
          "            switch(sub){\r",
          "                case \"Configuration\":\r",
          "                    let configList = await this.framework.dataStore.retrieve(subject, undefined) as EndpointConfig [];\r",
          "                    replyToSend = toMatch ? configList?.filter(x => this.matchesTemplate(x, toMatch)) : configList;\r",
          "                    break;\r",
          "                case \"Statistics\":\r",
          "                    let statList = await this.framework.dataStore.retrieve(statSubject, undefined) as EndpointStatistic[];\r",
          "                    replyToSend = toMatch ? statList?.filter(x => this.matchesTemplate(x, toMatch)) : statList;\r",
          "                    break;\r",
          "            }       \r",
          "\r",
          "            \r",
          "        } else {\r",
          "            var configToMatch = toMatch?.EndpointConfig;\r",
          "            var statToMatch = toMatch?.EndpointStatistic;\r",
          "\r",
          "            var configList = await this.framework.dataStore.retrieve(subject, undefined) as EndpointConfig[];\r",
          "            var statList = await this.framework.dataStore.retrieve(statSubject, undefined) as EndpointStatistic[];\r",
          "\r",
          "            replyToSend = {\r",
          "                EndpointConfig: configToMatch ? configList?.filter(x => this.matchesTemplate(x, configToMatch)) : configList,\r",
          "                EndpointStatistic: statToMatch ? statList?.filter(x => this.matchesTemplate(x, statToMatch)) : statList\r",
          "            };\r",
          "        }\r",
          "\r",
          "        return { reply: replyToSend, IsRequestOut: inputs.isRequest };\r",
          "\r",
          "        // emit output during execution: outputs.output1.emit(\"something\");\r",
          "        // return example: return { output1: inputs.input1, output2: \"Hello World\" };\r",
          "    }\r",
          "    \r",
          "    public parseTopic(input: string): { subsection?: string; topic?: string } {\r",
          "        let prefix = \"ExternalSystemsSimulator.Retrieve\"\r",
          "\r",
          "        if (!input.startsWith(prefix)) {\r",
          "            throw new Error(\"Invalid format\");\r",
          "        }\r",
          "\r",
          "        const rest = input === prefix ? \"\" : input.slice(prefix.length + 1);\r",
          "\r",
          "        if (!rest) {\r",
          "            return undefined;\r",
          "        }\r",
          "\r",
          "        const parts = rest.split(\".\");\r",
          "\r",
          "        if (parts.length === 1) {\r",
          "            return { topic: parts[0] };\r",
          "        }\r",
          "\r",
          "        if (parts.length === 2) {\r",
          "            const [subsection, topic] = parts;\r",
          "            return { subsection, topic };\r",
          "        }\r",
          "\r",
          "        throw new Error(\"Unexpected format\");\r",
          "    }\r",
          "\r",
          "    public matchesTemplate(item: unknown, template: unknown): boolean {\r",
          "        if (template === item) return true;\r",
          "\r",
          "        if (\r",
          "            typeof template !== \"object\" || template === null ||\r",
          "            typeof item !== \"object\" || item === null\r",
          "        ) {\r",
          "            return false;\r",
          "        }\r",
          "\r",
          "        if (Array.isArray(template)) {\r",
          "            if (!Array.isArray(item) || template.length !== item.length) return false;\r",
          "            return template.every((v, i) => this.matchesTemplate(item[i], v));\r",
          "        }\r",
          "\r",
          "        for (const [key, value] of Object.entries(template as Record<string, unknown>)) {\r",
          "            if (!this.matchesTemplate((item as Record<string, unknown>)[key], value)) {\r",
          "            return false;\r",
          "            }\r",
          "        }\r",
          "\r",
          "        return true;\r",
          "    }\r",
          "    \r",
          "    public removeMatches<T extends object>(items: T[], template: Partial<T>): T[] {\r",
          "        return items.filter(item => !this.matchesTemplate(item, template));\r",
          "    }\r",
          "\r",
          "}\r",
          "\r",
          "class RunningConfig {\r",
          "    DefaultStatusCode: string;\r",
          "    DefaultResponseBody: string;\r",
          "    RunningMode: RunningMode\r",
          "}\r",
          "\r",
          "enum RunningMode{\r",
          "    Full,\r",
          "    NoStatistics\r",
          "}\r",
          "\r",
          "\r",
          "//Model for AutomationEvent ExtendedData\r",
          "class CustomExtendedData {\r",
          "    DefaultActions: Action[];\r",
          "    DefaultBody: string;\r",
          "    DefaultStatusCode : number\r",
          "}\r",
          "\r",
          "//Model for ActionParameter for action of type LogEvent\r",
          "class LogEventParameter {\r",
          "    EntityType : string;\r",
          "    EntityId: string | undefined;\r",
          "    EntityName: string | undefined;\r",
          "    ToState : string;\r",
          "    IgnoreLastServiceId = false;\r",
          "}\r",
          "\r",
          "//Model for CustomCode \r",
          "class CustomCodeParameters {\r",
          "    ParameterNames: string[];\r",
          "    Parameters: any[];\r",
          "    Function: string;\r",
          "}\r",
          "\r",
          "//Generic data model\r",
          "class EndpointConfig{\r",
          "    Id: string|undefined;\r",
          "    StatusCode : number|undefined;\r",
          "    BodyToSend: any;\r",
          "    ActionsToExecute: Action[] | undefined;\r",
          "\r",
          "    constructor(init?: Partial<EndpointConfig>) {\r",
          "        Object.assign(this, init);\r",
          "        if(!this.Id){\r",
          "            this.Id = crypto.randomUUID();\r",
          "        }\r",
          "    }\r",
          "\r",
          "    static GetNew(statusCodeToSet: number, bodyToSet: any): EndpointConfig {\r",
          "        return new EndpointConfig({\r",
          "            Id: crypto.randomUUID(),\r",
          "            StatusCode: statusCodeToSet,\r",
          "            BodyToSend: bodyToSet,\r",
          "        });\r",
          "    }\r",
          "}\r",
          "\r",
          "class Action {\r",
          "    Id: string|undefined;\r",
          "    ActionType: string;\r",
          "    ActionState: ActionStates;\r",
          "    ActionParameter: any;\r",
          "    DependsOn: string[] | undefined;\r",
          "\r",
          "     constructor(init?: Partial<Action>) {\r",
          "        if(!init || !init.ActionType ||!init.ActionParameter){\r",
          "            throw new Error(\"Invalid input. Received: \" + JSON.stringify(init));\r",
          "        }\r",
          "        this.Id = init.Id ?? crypto.randomUUID();\r",
          "        this.ActionType = init.ActionType;\r",
          "        this.ActionState = init.ActionState ?? ActionStates.Created;\r",
          "        this.ActionParameter = init.ActionParameter;\r",
          "    }\r",
          "}\r",
          "\r",
          "class EndpointStatistic {\r",
          "    RequestId : string | undefined;\r",
          "    EndpointConfig: EndpointConfig|undefined;\r",
          "    ReceivedBody: any;\r",
          "    ReplySent: any;\r",
          "    StatusCodeSent: number|undefined;\r",
          "    Error: any\r",
          "}\r",
          "\r",
          "enum ActionStates {\r",
          "    \"Created\",\r",
          "    \"Requested\",\r",
          "    \"Processed\",\r",
          "    \"Failed\"\r",
          "}\r",
          ""
        ],
        "jsCodeBase64": "",
        "___cmf___name": "Code"
      }
    },
