    <Path value="UserDefined.ADOTelemetry.ADOTestFailureSuspectsTyped" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
    <QueryString value="-- ADOTestFailureSuspects: for every failing test streak, the PRs that were new in the build where the streak started.&#xA;-- &quot;New&quot; = in that build's RunChange list but not in the previous run of the same pipeline and environment.&#xA;-- Candidates only: temporal proximity, not proven causation.&#xA;WITH&#xA;streaks AS&#xA;(&#xA;    SELECT Organization, Project, coalesce(Pipeline, '') AS FailingPipeline, TestName AS Test,&#xA;        toString(FailingSinceBuildId) AS SinceBuildId,&#xA;        toFloat64(uniqExact(BuildId)) AS FailedBuilds,&#xA;        max(toFloat64(toUnixTimestamp64Milli(FailingUntil)) / 1000) AS LastFailed&#xA;    FROM ADOTelemetry_TestFailure FINAL&#xA;    WHERE coalesce(FailingSinceBuildId, 0) &gt; 0&#xA;    GROUP BY Organization, Project, FailingPipeline, Test, SinceBuildId&#xA;),&#xA;runs AS&#xA;(&#xA;    SELECT Organization, Project, BuildId, Pipeline, Environment, Started,&#xA;        lagInFrame(BuildId, 1, '') OVER (PARTITION BY Organization, Project, Pipeline, Environment ORDER BY Started&#xA;            ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS PrevBuildId&#xA;    FROM&#xA;    (&#xA;        SELECT Organization, Project, toString(BuildId) AS BuildId, coalesce(Pipeline, '') AS Pipeline,&#xA;            coalesce(Environment, '') AS Environment, toFloat64(toUnixTimestamp64Milli(Started)) / 1000 AS Started&#xA;        FROM ADOTelemetry_PipelineRun FINAL&#xA;        WHERE Started IS NOT NULL AND Finished IS NOT NULL&#xA;    )&#xA;),&#xA;changes AS&#xA;(&#xA;    SELECT Organization, Project, toString(BuildId) AS BuildId,&#xA;        arrayDistinct(arrayFilter(x -&gt; x != '', splitByChar(';', coalesce(PullRequestIds, '')))) AS PRs&#xA;    FROM ADOTelemetry_RunChange FINAL&#xA;),&#xA;newPrs AS&#xA;(&#xA;    SELECT runs.Organization AS Organization, runs.Project AS Project, runs.BuildId AS BuildId, runs.Pipeline AS Pipeline,&#xA;        runs.Environment AS Environment, runs.Started AS Started, runs.PrevBuildId AS PrevBuildId,&#xA;        arrayJoin(arrayFilter(x -&gt; NOT has(prev.PRs, x), cur.PRs)) AS PullRequestId&#xA;    FROM runs&#xA;    INNER JOIN changes AS cur ON cur.Organization = runs.Organization AND cur.Project = runs.Project AND cur.BuildId = runs.BuildId&#xA;    INNER JOIN changes AS prev ON prev.Organization = runs.Organization AND prev.Project = runs.Project AND prev.BuildId = runs.PrevBuildId&#xA;    WHERE runs.PrevBuildId != ''&#xA;),&#xA;prs AS&#xA;(&#xA;    SELECT Organization, Project, coalesce(Repository, '') AS Repository, toString(PullRequestId) AS PullRequestId,&#xA;        coalesce(TargetBranch, '') AS TargetBranch, coalesce(Author, '') AS Author, coalesce(Title, '') AS Title,&#xA;        toFloat64(toUnixTimestamp64Milli(coalesce(Merged, Closed))) / 1000 AS Merged&#xA;    FROM ADOTelemetry_PullRequest FINAL&#xA;),&#xA;teams AS&#xA;(&#xA;    SELECT Organization, Project, toString(PullRequestId) AS PullRequestId,&#xA;        anyIf(Team, coalesce(Team, '') != '') AS Team&#xA;    FROM ADOTelemetry_PullRequestWorkItem FINAL&#xA;    GROUP BY Organization, Project, PullRequestId&#xA;)&#xA;SELECT streaks.Organization AS Organization, streaks.Project AS Project, streaks.FailingPipeline AS FailingPipeline,&#xA;    streaks.Test AS Test, streaks.SinceBuildId AS FailingSinceBuildId, streaks.FailedBuilds AS FailedBuilds, streaks.LastFailed AS LastFailed,&#xA;    newPrs.Pipeline AS SinceBuildPipeline, newPrs.Environment AS Environment, newPrs.Started AS SinceBuildStarted, newPrs.PrevBuildId AS PrevBuildId,&#xA;    newPrs.PullRequestId AS PullRequestId, prs.Repository AS Repository, prs.TargetBranch AS TargetBranch, prs.Author AS Author,&#xA;    prs.Title AS Title, prs.Merged AS Merged, coalesce(teams.Team, '') AS Team&#xA;FROM streaks&#xA;INNER JOIN newPrs ON newPrs.Organization = streaks.Organization AND newPrs.Project = streaks.Project AND newPrs.BuildId = streaks.SinceBuildId&#xA;LEFT JOIN prs ON prs.Organization = newPrs.Organization AND prs.Project = newPrs.Project AND prs.PullRequestId = newPrs.PullRequestId&#xA;LEFT JOIN teams ON teams.Organization = newPrs.Organization AND teams.Project = newPrs.Project AND teams.PullRequestId = newPrs.PullRequestId" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
