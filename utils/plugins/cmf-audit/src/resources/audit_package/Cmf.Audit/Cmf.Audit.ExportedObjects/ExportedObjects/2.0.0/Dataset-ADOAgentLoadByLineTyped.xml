    <Path value="UserDefined.ADOTelemetry.ADOAgentLoadByLineTyped" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
    <QueryString value="-- ADOAgentLoadByLine: busy agents per minute, pool and product line, rolling 90 days.&#xA;-- Jobs whose run is gone from Azure DevOps are labelled by pipeline type (PR-/CI-/CD- prefix), PoolMaintenance as 'Pool maintenance', the rest 'Other job (no run)'.&#xA;WITH&#xA;runs AS&#xA;(&#xA;    SELECT toString(BuildId) AS BuildId,&#xA;        multiIf(&#xA;            coalesce(Role, '') NOT IN ('CI', 'PR'), 'CD / Publish',&#xA;            startsWith(branch, 'refs/heads/development'), 'development',&#xA;            startsWith(branch, 'refs/heads/release/'), extract(branch, 'refs/heads/(release/[^/]+)'),&#xA;            'Other') AS Line&#xA;    FROM&#xA;    (&#xA;        SELECT BuildId, Role, if(coalesce(Role, '') = 'PR', coalesce(TargetBranch, ''), coalesce(SourceBranch, '')) AS branch&#xA;        FROM ADOTelemetry_PipelineRun FINAL&#xA;    )&#xA;),&#xA;jobs AS&#xA;(&#xA;    SELECT Organization, Project, Pool, if(coalesce(BuildId, 0) &gt; 0, toString(BuildId), '') AS BuildId,&#xA;        coalesce(Agent, '') AS Agent, coalesce(Pipeline, '') AS JobFlow,&#xA;        toInt64(toUnixTimestamp(Assigned)) AS S, toInt64(toUnixTimestamp(Finished)) AS F&#xA;    FROM ADOTelemetry_AgentJob FINAL&#xA;    WHERE RequestId &gt;= (SELECT min(RequestId) FROM ADOTelemetry_AgentJob WHERE Queued &gt;= now() - INTERVAL 90 DAY)&#xA;        AND Assigned IS NOT NULL AND Finished IS NOT NULL&#xA;)&#xA;SELECT j.Organization AS Organization, j.Pool AS Pool,&#xA;    multiIf(r.Line != '', r.Line, startsWith(j.JobFlow, 'PR-'), 'PR run (no longer in Azure DevOps)', startsWith(j.JobFlow, 'CI-'), 'CI run (no longer in Azure DevOps)', startsWith(j.JobFlow, 'CD-'), 'CD run (no longer in Azure DevOps)', j.JobFlow = 'PoolMaintenance', 'Pool maintenance', 'Other job (no run)') AS Line,&#xA;    toFloat64(m * 60000) AS Minute,&#xA;    toFloat64(uniqExact(j.Agent)) AS BusyAgents&#xA;FROM jobs AS j&#xA;LEFT JOIN runs AS r ON r.BuildId = j.BuildId&#xA;ARRAY JOIN range(intDiv(j.S, 60), intDiv(greatest(j.F, j.S), 60) + 1) AS m&#xA;GROUP BY Organization, Pool, Line, m" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
