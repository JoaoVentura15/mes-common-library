    <Path value="UserDefined.ADOTelemetry.ADOScopeDimensionsTyped" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
    <QueryString value="SELECT&#10;    Organization,&#10;    Project,&#10;    ifNull(Milestone, &#x27;&#x27;) AS Milestone,&#10;    ifNull(Team, &#x27;&#x27;) AS Team,&#10;    toUInt32(ifNull(EpicId, 0)) AS EpicId,&#10;    ifNull(EpicTitle, &#x27;&#x27;) AS EpicTitle,&#10;    concat(toString(GroupId), &#x27; - &#x27;, substring(replaceAll(replaceRegexpAll(GroupTitle, &#x27;[,|=&amp;?#%+;&quot;&lt;&gt;$@!*~`{}^]&#x27;, &#x27; &#x27;), char(39), &#x27; &#x27;), 1, 80)) AS GroupLabel,&#10;    toUInt32(count()) AS Items,&#10;    toUInt32(countIf(Done = 0)) AS OpenItems&#10;FROM&#10;(&#10;    SELECT Organization, Project, Milestone, Team, EpicId, EpicTitle, Done,&#10;        if(ifNull(FeatureId, 0) &gt; 0, toUInt32(FeatureId), toUInt32(ifNull(EpicId, 0))) AS GroupId,&#10;        multiIf(ifNull(FeatureId, 0) &gt; 0, ifNull(FeatureTitle, &#x27;&#x27;), ifNull(EpicId, 0) &gt; 0, concat(&#x27;Epic: &#x27;, ifNull(EpicTitle, &#x27;&#x27;), &#x27; (no feature)&#x27;), &#x27;(standalone)&#x27;) AS GroupTitle&#10;    FROM ADOTelemetry_WorkItemScope FINAL&#10;    WHERE Removed = 0&#10;)&#10;GROUP BY Organization, Project, Milestone, Team, EpicId, EpicTitle, GroupLabel&#10;" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
