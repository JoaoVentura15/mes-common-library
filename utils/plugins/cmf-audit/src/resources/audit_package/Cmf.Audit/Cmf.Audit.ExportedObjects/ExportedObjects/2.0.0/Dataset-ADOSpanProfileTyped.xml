    <QueryString value="-- ADOSpanProfile (typed): median offset and duration per step for the slowest 5 percent runs versus the rest, per pipeline and target branch, last 30 days.&#xD;&#xA;-- Reads ADOTelemetry_PipelineRun / ADOTelemetry_PipelineStep only. Plain INNER JOINs on purpose: ANY JOIN keeps one left row per key and would drop runs and steps here.&#xD;&#xA;WITH&#xD;&#xA;runs AS&#xD;&#xA;(&#xD;&#xA;    SELECT Organization, Project, coalesce(Pipeline, '') AS Pipeline, BuildId,&#xD;&#xA;        if(coalesce(TargetBranch, '') = '', '(no pull request)', replaceOne(coalesce(TargetBranch, ''), 'refs/heads/', '')) AS Branch,&#xD;&#xA;        toInt64(toUnixTimestamp(coalesce(Started, QueuedAt))) * 1000 AS RunStart,&#xD;&#xA;        toInt64(round(if(coalesce(DurationSeconds, 0) &gt; 0, toFloat64(DurationSeconds), greatest(toFloat64(toUnixTimestamp(coalesce(Finished, Started, QueuedAt))) - toFloat64(toUnixTimestamp(coalesce(Started, QueuedAt))), 0)) * 1000)) AS RunDur&#xD;&#xA;    FROM ADOTelemetry_PipelineRun FINAL&#xD;&#xA;    WHERE coalesce(Started, QueuedAt) &gt;= now() - INTERVAL 30 DAY&#xD;&#xA;),&#xD;&#xA;thr AS&#xD;&#xA;(&#xD;&#xA;    SELECT Pipeline, quantileExact(0.95)(RunDur) AS P95 FROM runs GROUP BY Pipeline&#xD;&#xA;),&#xD;&#xA;cls AS&#xD;&#xA;(&#xD;&#xA;    SELECT r.Organization AS Organization, r.Project AS Project, r.Pipeline AS Pipeline, r.BuildId AS BuildId, r.Branch AS Branch,&#xD;&#xA;        r.RunStart AS RunStart, r.RunDur AS RunDur,&#xD;&#xA;        if(t.P95 &gt; 0 AND r.RunDur &gt;= t.P95, 'Slowest 5 percent', 'Rest') AS Bucket&#xD;&#xA;    FROM runs AS r INNER JOIN thr AS t ON t.Pipeline = r.Pipeline&#xD;&#xA;),&#xD;&#xA;stepoff AS&#xD;&#xA;(&#xD;&#xA;    SELECT c.Pipeline AS Pipeline, c.Branch AS Branch, c.Bucket AS Bucket, c.BuildId AS BuildId,&#xD;&#xA;        coalesce(s.StepName, '') AS StepName, if(coalesce(s.Category, '') = '', 'other', s.Category) AS Category,&#xD;&#xA;        toInt64(toUnixTimestamp(s.Started)) * 1000 - c.RunStart AS Off, toInt64(round(toFloat64(coalesce(s.DurationSeconds, 0)) * 1000)) AS Dur&#xD;&#xA;    FROM&#xD;&#xA;    (&#xD;&#xA;        SELECT Organization, Project, BuildId, StepName, Category, Started, DurationSeconds&#xD;&#xA;        FROM ADOTelemetry_PipelineStep FINAL&#xD;&#xA;        -- BuildId only grows over time and is in the sort key, so the window's lowest BuildId prunes granules as the table grows&#xD;&#xA;        WHERE BuildId &gt;= (SELECT min(BuildId) FROM runs) AND RecordType = 'Task' AND Started IS NOT NULL AND RecordId != ''&#xD;&#xA;    ) AS s&#xD;&#xA;    INNER JOIN cls AS c ON c.Organization = s.Organization AND c.Project = s.Project AND c.BuildId = s.BuildId&#xD;&#xA;)&#xD;&#xA;SELECT&#xD;&#xA;    Pipeline, Branch, Bucket,&#xD;&#xA;    concat(Pipeline, ' | ', Branch, ' | ', Bucket) AS traceID,&#xD;&#xA;    concat('s-', hex(cityHash64(concat(Pipeline, Branch, Bucket, StepName)))) AS spanID,&#xD;&#xA;    concat('root-', hex(cityHash64(concat(Pipeline, Branch, Bucket)))) AS parentSpanID,&#xD;&#xA;    StepName AS operationName,&#xD;&#xA;    any(Category) AS serviceName,&#xD;&#xA;    toInt64(toUnixTimestamp(toStartOfDay(now()))) * 1000 + toInt64(quantileExact(0.5)(Off)) AS startTime,&#xD;&#xA;    toInt64(quantileExact(0.5)(Dur)) AS duration,&#xD;&#xA;    toInt64(count()) AS Samples,&#xD;&#xA;    toInt64(uniqExact(BuildId)) AS Runs&#xD;&#xA;FROM stepoff&#xD;&#xA;GROUP BY Pipeline, Branch, Bucket, StepName&#xD;&#xA;UNION ALL&#xD;&#xA;SELECT&#xD;&#xA;    Pipeline, Branch, Bucket,&#xD;&#xA;    concat(Pipeline, ' | ', Branch, ' | ', Bucket) AS traceID,&#xD;&#xA;    concat('root-', hex(cityHash64(concat(Pipeline, Branch, Bucket)))) AS spanID,&#xD;&#xA;    '' AS parentSpanID,&#xD;&#xA;    concat(Pipeline, ' median run (', toString(uniqExact(BuildId)), ' runs)') AS operationName,&#xD;&#xA;    'Run' AS serviceName,&#xD;&#xA;    toInt64(toUnixTimestamp(toStartOfDay(now()))) * 1000 AS startTime,&#xD;&#xA;    toInt64(quantileExact(0.5)(RunDur)) AS duration,&#xD;&#xA;    toInt64(count()) AS Samples,&#xD;&#xA;    toInt64(uniqExact(BuildId)) AS Runs&#xD;&#xA;FROM cls&#xD;&#xA;GROUP BY Pipeline, Branch, Bucket" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
