    <QueryString value="-- Median step offset and duration of successful PR runs of the last 60 days, per pipeline and platform.&#xA;-- BuildId only grows and leads the sort key after Organization/Project, so a lower bound on it prunes granules on both tables.&#xA;WITH&#xA;firstBuild AS (SELECT min(BuildId) AS Id FROM ADOTelemetry_PipelineRun WHERE Started &gt;= now() - INTERVAL 61 DAY),&#xA;runstats AS&#xA;(&#xA;    SELECT Organization, Project, coalesce(Pipeline, '') AS Pipeline, BuildId,&#xA;        if(coalesce(Platform, '') = '', '(unknown)', Platform) AS Platform,&#xA;        toInt64(round(toFloat64(toUnixTimestamp(coalesce(Started, QueuedAt))) * 1000)) AS RunStart,&#xA;        toInt64(round(if(coalesce(DurationSeconds, 0) &gt; 0, toFloat64(DurationSeconds),&#xA;            greatest(toFloat64(toUnixTimestamp(coalesce(Finished, Started, QueuedAt))) - toFloat64(toUnixTimestamp(coalesce(Started, QueuedAt))), 0)) * 1000)) AS RunDur&#xA;    FROM ADOTelemetry_PipelineRun FINAL&#xA;    WHERE BuildId &gt;= (SELECT Id FROM firstBuild)&#xA;        AND coalesce(Role, '') = 'PR' AND coalesce(Result, '') = 'succeeded'&#xA;        AND coalesce(Started, QueuedAt) IS NOT NULL&#xA;        AND toUnixTimestamp(coalesce(Started, QueuedAt)) &gt;= toUnixTimestamp(now()) - 60 * 86400&#xA;),&#xA;stepoff AS&#xA;(&#xA;    SELECT c.Pipeline AS Pipeline, c.Platform AS Platform, c.BuildId AS BuildId, coalesce(s.StepName, '') AS StepName,&#xA;        coalesce(s.Category, '') AS Category,&#xA;        toInt64(round(toFloat64(toUnixTimestamp(s.Started)) * 1000)) - c.RunStart AS Off,&#xA;        toInt64(round(toFloat64(coalesce(s.DurationSeconds, 0)) * 1000)) AS Dur&#xA;    FROM&#xA;    (&#xA;        SELECT Organization, Project, BuildId, RecordId, StepName, Category, Started, DurationSeconds&#xA;        FROM ADOTelemetry_PipelineStep FINAL&#xA;        WHERE BuildId &gt;= (SELECT Id FROM firstBuild) AND RecordType = 'Task' AND Started IS NOT NULL AND RecordId != ''&#xA;    ) AS s&#xA;    INNER JOIN runstats AS c ON c.Organization = s.Organization AND c.Project = s.Project AND c.BuildId = s.BuildId&#xA;    WHERE c.RunDur &gt; 0&#xA;)&#xA;SELECT Pipeline, Platform, concat(Pipeline, ' | ', Platform) AS traceID,&#xA;    concat('s-', hex(cityHash64(concat(Pipeline, Platform, StepName)))) AS spanID,&#xA;    concat('root-', hex(cityHash64(concat(Pipeline, Platform)))) AS parentSpanID,&#xA;    StepName AS operationName, any(if(Category = '', 'other', Category)) AS serviceName,&#xA;    toInt64(toUnixTimestamp(toStartOfDay(now()))) * 1000 + toInt64(quantileExact(0.5)(Off)) AS startTime,&#xA;    toInt64(quantileExact(0.5)(Dur)) AS duration, toInt64(count()) AS Samples, toInt64(uniqExact(BuildId)) AS Runs&#xA;FROM stepoff GROUP BY Pipeline, Platform, StepName&#xA;UNION ALL&#xA;SELECT Pipeline, Platform, concat(Pipeline, ' | ', Platform) AS traceID,&#xA;    concat('root-', hex(cityHash64(concat(Pipeline, Platform)))) AS spanID, '' AS parentSpanID,&#xA;    concat(Pipeline, ' median successful PR run (', toString(count()), ' runs)') AS operationName, 'Run' AS serviceName,&#xA;    toInt64(toUnixTimestamp(toStartOfDay(now()))) * 1000 AS startTime,&#xA;    toInt64(quantileExact(0.5)(RunDur)) AS duration, toInt64(count()) AS Samples, toInt64(count()) AS Runs&#xA;FROM runstats GROUP BY Pipeline, Platform" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
