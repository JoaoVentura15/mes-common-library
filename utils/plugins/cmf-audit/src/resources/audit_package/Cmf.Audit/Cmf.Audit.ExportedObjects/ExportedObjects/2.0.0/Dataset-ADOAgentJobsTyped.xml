    <QueryString value="-- Rolling 90 days. RequestId only grows, so a lower bound on it (the second sort-key column) prunes granules like BuildId does.&#xA;SELECT&#xA;    Organization, toInt64(RequestId) AS RequestId, Project, coalesce(Agent, '') AS Agent, Pool, coalesce(Pipeline, '') AS Pipeline,&#xA;    if(coalesce(BuildId, 0) &gt; 0, toInt64(BuildId), NULL) AS BuildId, coalesce(PlanType, '') AS PlanType, coalesce(Result, '') AS Result,&#xA;    toFloat64(WaitSeconds) AS WaitSeconds, toFloat64(BusySeconds) AS BusySeconds,&#xA;    toDateTime(Queued, 'UTC') AS QueuedAt, toDateTime(Assigned, 'UTC') AS AssignedAt, toDateTime(Finished, 'UTC') AS FinishedAt&#xA;FROM ADOTelemetry_AgentJob FINAL&#xA;WHERE RequestId &gt;= (SELECT min(RequestId) FROM ADOTelemetry_AgentJob WHERE Queued &gt;= now() - INTERVAL 90 DAY)" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
