    <Path value="UserDefined.ADOTelemetry.ADOTimeToRestoreTyped" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
    <QueryString value="-- ADOTimeToRestore: one row per failure episode of a CD pipeline, per environment (episodes of different pipelines are kept separate).&#xA;-- A &quot;deployment&quot; is a CD run that got through install, master data and tests and reached the approval stage (ReleaseOutcome set).&#xA;-- A failure is a run that failed before that point (Result = failed, no ReleaseOutcome). Cancelled runs are ignored.&#xA;-- An episode = the consecutive failures between two deployments. Restored = start of the next run that reached the approval stage.&#xA;-- Open episodes have no Restored / TimeToRestore. Timestamps are in seconds.&#xA;WITH&#xA;runs AS&#xA;(&#xA;    SELECT Organization, Project, toString(BuildId) AS BuildId, coalesce(Pipeline, '') AS Pipeline,&#xA;        coalesce(Environment, '') AS Environment, coalesce(Result, '') AS Result, coalesce(ReleaseOutcome, '') AS ReleaseOutcome,&#xA;        toFloat64(toUnixTimestamp(Started)) AS Started, toFloat64(toUnixTimestamp(Finished)) AS Finished&#xA;    FROM ADOTelemetry_PipelineRun FINAL&#xA;    WHERE Role = 'CD' AND Started IS NOT NULL AND Finished IS NOT NULL AND coalesce(Result, '') != 'canceled'&#xA;),&#xA;perEnv AS&#xA;(&#xA;    SELECT Organization, Project, Pipeline, Environment,&#xA;        groupArray(tuple(Started, Finished, Result, toUInt8(ReleaseOutcome != ''), BuildId)) AS arr,&#xA;        groupArray(tuple(Started, Finished, Result, toUInt8(ReleaseOutcome != ''), BuildId)) AS allRuns&#xA;    FROM runs GROUP BY Organization, Project, Pipeline, Environment&#xA;),&#xA;fails AS&#xA;(&#xA;    SELECT Organization, Project, Pipeline, Environment, f.1 AS Started, f.2 AS Finished, f.5 AS BuildId,&#xA;        arrayMax(arrayMap(x -&gt; if(x.4 = 1 AND x.1 &lt; f.1, x.1, 0.), allRuns)) AS PrevDeploymentStarted,&#xA;        arrayMin(arrayMap(x -&gt; if(x.4 = 1 AND x.1 &gt; f.1, x.1, 1e18), allRuns)) AS NextDeploymentStarted&#xA;    FROM perEnv&#xA;    ARRAY JOIN arr AS f&#xA;    WHERE f.3 = 'failed' AND f.4 = 0&#xA;)&#xA;SELECT Organization, Project, Environment,&#xA;    min(Started) AS FirstFailed,&#xA;    argMin(BuildId, Started) AS FirstFailedBuildId,&#xA;    toFloat64(count()) AS FailedAttempts,&#xA;    max(Finished) AS LastFailedFinished,&#xA;    if(min(NextDeploymentStarted) &gt;= 1e17, NULL, toNullable(min(NextDeploymentStarted))) AS Restored,&#xA;    if(min(NextDeploymentStarted) &gt;= 1e17, NULL, toNullable(min(NextDeploymentStarted) - min(Started))) AS TimeToRestore,&#xA;    toFloat64(min(NextDeploymentStarted) &gt;= 1e17) AS IsOpen&#xA;FROM fails&#xA;GROUP BY Organization, Project, Pipeline, Environment, PrevDeploymentStarted" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
