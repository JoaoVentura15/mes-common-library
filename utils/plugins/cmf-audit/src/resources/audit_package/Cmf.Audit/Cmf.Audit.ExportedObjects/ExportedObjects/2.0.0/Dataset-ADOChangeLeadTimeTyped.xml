    <Path value="UserDefined.ADOTelemetry.ADOChangeLeadTimeTyped" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
    <QueryString value="WITH&#xA;runs AS&#xA;(&#xA;    SELECT Organization, Project, toString(BuildId) AS BuildId, coalesce(Pipeline, '') AS Pipeline,&#xA;        coalesce(Environment, '') AS Environment, coalesce(Result, '') AS Result, coalesce(ReleaseOutcome, '') AS ReleaseOutcome,&#xA;        toFloat64(toUnixTimestamp(Started)) AS Started, toFloat64(toUnixTimestamp(Finished)) AS Finished&#xA;    FROM ADOTelemetry_PipelineRun FINAL&#xA;    WHERE Role = 'CD' AND Started IS NOT NULL AND Finished IS NOT NULL&#xA;),&#xA;firstRuns AS&#xA;(&#xA;    SELECT Organization, Project, Pipeline, Environment, min(Started) AS FirstCollected&#xA;    FROM runs GROUP BY Organization, Project, Pipeline, Environment&#xA;),&#xA;changes AS&#xA;(&#xA;    SELECT Organization, Project, toString(BuildId) AS BuildId,&#xA;        arrayJoin(arrayDistinct(splitByChar(';', coalesce(PullRequestIds, '')))) AS PullRequestId&#xA;    FROM ADOTelemetry_RunChange FINAL&#xA;    WHERE coalesce(PullRequestIds, '') != ''&#xA;),&#xA;prs AS&#xA;(&#xA;    SELECT Organization, Project, coalesce(Repository, '') AS Repository, toString(PullRequestId) AS PullRequestId,&#xA;        coalesce(TargetBranch, '') AS TargetBranch, coalesce(Author, '') AS Author,&#xA;        toFloat64(toUnixTimestamp(coalesce(Merged, Closed))) AS Merged&#xA;    FROM ADOTelemetry_PullRequest FINAL&#xA;    WHERE Status = 'completed'&#xA;),&#xA;teams AS&#xA;(&#xA;    SELECT Organization, Project, toString(PullRequestId) AS PullRequestId,&#xA;        anyIf(Team, coalesce(Team, '') != '') AS Team&#xA;    FROM ADOTelemetry_PullRequestWorkItem FINAL&#xA;    GROUP BY Organization, Project, PullRequestId&#xA;),&#xA;hits AS&#xA;(&#xA;    SELECT prs.Organization AS Organization, prs.Project AS Project, prs.Repository AS Repository, prs.PullRequestId AS PullRequestId,&#xA;        prs.TargetBranch AS TargetBranch, prs.Author AS Author, prs.Merged AS Merged,&#xA;        runs.Pipeline AS Pipeline, runs.Environment AS Environment, runs.BuildId AS BuildId, runs.Result AS Result,&#xA;        runs.ReleaseOutcome AS ReleaseOutcome, runs.Started AS Started, runs.Finished AS Finished&#xA;    FROM prs&#xA;    INNER JOIN changes ON changes.Organization = prs.Organization AND changes.Project = prs.Project AND changes.PullRequestId = prs.PullRequestId&#xA;    INNER JOIN runs ON runs.Organization = changes.Organization AND runs.Project = changes.Project AND runs.BuildId = changes.BuildId&#xA;    WHERE prs.Merged &gt; 0 AND runs.Started &gt;= prs.Merged&#xA;),&#xA;perPr AS&#xA;(&#xA;    SELECT Organization, Project, Repository, PullRequestId, TargetBranch, Author, Merged, Pipeline, Environment,&#xA;        min(Started) AS FirstCDStarted,&#xA;        argMin(BuildId, Started) AS FirstCDBuildId,&#xA;        argMin(Result, Started) AS FirstCDResult,&#xA;        minIf(Finished, ReleaseOutcome IN ('ReleasedClean', 'ReleasedWithFailures')) AS ReleasedRaw,&#xA;        argMinIf(BuildId, Finished, ReleaseOutcome IN ('ReleasedClean', 'ReleasedWithFailures')) AS ReleasedBuildId,&#xA;        countIf(ReleaseOutcome IN ('ReleasedClean', 'ReleasedWithFailures')) AS ReleasingRuns,&#xA;        groupArray(tuple(Started, Result)) AS Attempts&#xA;    FROM hits&#xA;    GROUP BY Organization, Project, Repository, PullRequestId, TargetBranch, Author, Merged, Pipeline, Environment&#xA;)&#xA;SELECT perPr.Organization AS Organization, perPr.Project AS Project, perPr.Repository AS Repository,&#xA;    perPr.PullRequestId AS PullRequestId, perPr.TargetBranch AS TargetBranch, perPr.Author AS Author,&#xA;    coalesce(teams.Team, '') AS Team, perPr.Pipeline AS Pipeline, perPr.Environment AS Environment,&#xA;    perPr.Merged AS Merged, perPr.FirstCDStarted AS FirstCDStarted, perPr.FirstCDBuildId AS FirstCDBuildId, perPr.FirstCDResult AS FirstCDResult,&#xA;    if(perPr.ReleasingRuns = 0, NULL, toNullable(perPr.ReleasedRaw)) AS Released,&#xA;    if(perPr.ReleasingRuns = 0, '', perPr.ReleasedBuildId) AS ReleasedBuildId,&#xA;    perPr.FirstCDStarted - perPr.Merged AS MergeToFirstCD,&#xA;    if(perPr.ReleasingRuns = 0, NULL, toNullable(perPr.ReleasedRaw - perPr.Merged)) AS MergeToRelease,&#xA;    toFloat64(arrayCount(a -&gt; perPr.ReleasingRuns = 0 OR a.1 &lt;= perPr.ReleasedRaw, perPr.Attempts)) AS CDAttempts,&#xA;    toFloat64(arrayCount(a -&gt; (perPr.ReleasingRuns = 0 OR a.1 &lt;= perPr.ReleasedRaw) AND a.2 = 'failed', perPr.Attempts)) AS FailedCDAttempts,&#xA;    toFloat64(perPr.ReleasingRuns &gt; 0) AS IsReleased&#xA;FROM perPr&#xA;INNER JOIN firstRuns ON firstRuns.Organization = perPr.Organization AND firstRuns.Project = perPr.Project&#xA;    AND firstRuns.Pipeline = perPr.Pipeline AND firstRuns.Environment = perPr.Environment&#xA;LEFT JOIN teams ON teams.Organization = perPr.Organization AND teams.Project = perPr.Project AND teams.PullRequestId = perPr.PullRequestId&#xA;WHERE perPr.Merged &gt;= firstRuns.FirstCollected" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
