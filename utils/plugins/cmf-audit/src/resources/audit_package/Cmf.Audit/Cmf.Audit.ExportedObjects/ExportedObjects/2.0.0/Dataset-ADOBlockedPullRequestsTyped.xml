    <QueryString value="WITH markers AS (SELECT Organization, Project, PullRequestId, ObservedAt, SnapshotStatus FROM ADOTelemetry_PullRequestPolicy FINAL WHERE PolicyId = 0)&#xA;SELECT p.Organization AS Organization, p.Project AS Project, coalesce(p.Repository, '') AS Repository,&#xA;toInt64(p.PullRequestId) AS PullRequestId, toInt64(p.PolicyId) AS PolicyId, coalesce(p.Title, '') AS Title,&#xA;coalesce(p.TargetBranch, '') AS TargetBranch, coalesce(p.HeadCommit, '') AS HeadCommit,&#xA;toInt64(coalesce(p.DefinitionId, 0)) AS DefinitionId, toInt64(coalesce(p.BuildId, 0)) AS BuildId,&#xA;coalesce(b.Pipeline, '') AS Pipeline, coalesce(b.Result, '') AS BuildResult,&#xA;coalesce(f.RecordId, '') AS RecordId,&#xA;if(coalesce(f.Category, '') = '', 'Unknown', f.Category) AS ErrorCategory,&#xA;coalesce(f.ErrorCode, '') AS ErrorCode, coalesce(f.ErrorMessage, '') AS ErrorMessage,&#xA;coalesce(f.Fingerprint, '') AS Fingerprint,&#xA;if(coalesce(f.ScanStatus, '') = '', 'NoLinkedTaskEvidence', f.ScanStatus) AS ScanStatus,&#xA;p.CreatedAt AS CreatedAt, p.ObservedAt AS ObservedAt, p.EvaluationCompletedAt AS EvaluationCompletedAt,&#xA;if(p.CreatedAt IS NULL, NULL, greatest(0, dateDiff('second', p.CreatedAt, p.ObservedAt)) / 86400.0) AS DaysOpenAtObservation&#xA;FROM (SELECT * FROM ADOTelemetry_PullRequestPolicy FINAL) AS p&#xA;INNER JOIN markers AS m ON p.Organization = m.Organization AND p.Project = m.Project AND p.PullRequestId = m.PullRequestId AND p.ObservedAt = m.ObservedAt&#xA;LEFT JOIN (SELECT Organization, Project, BuildId, Pipeline, Result FROM ADOTelemetry_PipelineRun FINAL) AS b ON p.Organization = b.Organization AND p.Project = b.Project AND p.BuildId = b.BuildId&#xA;LEFT JOIN (SELECT Organization, Project, BuildId, RecordId, Category, ErrorCode, ErrorMessage, Fingerprint, ScanStatus FROM ADOTelemetry_PipelineFailure FINAL) AS f ON p.Organization = f.Organization AND p.Project = f.Project AND p.BuildId = f.BuildId&#xA;WHERE m.SnapshotStatus = 'Complete' AND p.PolicyId &gt; 0 AND p.PRStatus = 'active' AND p.IsDraft = 'false' AND p.FailingBuildPolicy = 1" type="System.String, System.Private.CoreLib, Version=8.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e" />
